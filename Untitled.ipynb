-- DROP COMMANDS
-- ==========================================


-- 16. Drop my_table2

DROP TABLE my_table2;


-- 17. Drop foreign key constraint fk_id

ALTER TABLE my_table2
DROP FOREIGN KEY fk_id;


-- 18. Drop PRIMARY KEY

ALTER TABLE my_table
DROP PRIMARY KEY;


-- 19. Drop age column

ALTER TABLE my_table
DROP COLUMN age;


-- 20. Drop DDL_Commands database

DROP DATABASE DDL_Commands;

